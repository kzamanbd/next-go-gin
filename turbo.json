{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "bin/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_URL", "PORT"]
    },
    "start": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_URL", "PORT"]
    }
  }
}
